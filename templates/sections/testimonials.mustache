{{!
    @template theme_instracta/sections/testimonials

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
<div class="instracta-quotes{{#layout_grid}} instracta-grid instracta-grid--3{{/layout_grid}}{{#layout_slider}} instracta-carousel{{/layout_slider}}"{{#layout_slider}} data-instracta-carousel="1"{{/layout_slider}}>
    {{#layout_slider}}<div class="instracta-carousel__track" tabindex="0">{{/layout_slider}}
    {{#items}}
    <figure class="instracta-quote">
        <i class="fa-solid fa-quote-left instracta-quote__mark" aria-hidden="true"></i>
        <blockquote class="instracta-quote__text">{{quote}}</blockquote>
        <figcaption class="instracta-quote__who">
            {{#hasavatar}}<img class="instracta-avatar" src="{{avatar}}" alt="" loading="lazy">{{/hasavatar}}
            {{^hasavatar}}<span class="instracta-avatar instracta-avatar--initial" aria-hidden="true">{{initial}}</span>{{/hasavatar}}
            <span><strong>{{name}}</strong>{{#role}}<small>{{role}}</small>{{/role}}</span>
        </figcaption>
    </figure>
    {{/items}}
    {{#layout_slider}}</div>
    <div class="instracta-carousel__nav">
        <button type="button" class="instracta-carousel__btn" data-instracta-dir="-1" aria-label="{{#str}}previous, core{{/str}}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <button type="button" class="instracta-carousel__btn" data-instracta-dir="1" aria-label="{{#str}}next, core{{/str}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </div>{{/layout_slider}}
</div>

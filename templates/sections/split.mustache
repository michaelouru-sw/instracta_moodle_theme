{{!
    @template theme_instracta/sections/split

    Instracta page builder template.

    Example context (json):
    {}
}}
<div class="instracta-split{{#imageside_left}} instracta-split--rev{{/imageside_left}}">
    <div class="instracta-split__text">
        {{#eyebrow}}<p class="instracta-eyebrow">{{eyebrow}}</p>{{/eyebrow}}
        {{#title}}<h2 class="instracta-title">{{title}}</h2>{{/title}}
        <div class="instracta-prose">{{{text}}}</div>
        {{#hasbullets}}
        <ul class="instracta-checks">
            {{#bullets}}<li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{{text}}</span></li>{{/bullets}}
        </ul>
        {{/hasbullets}}
        {{#hasbtn}}<a class="btn btn-primary btn-lg" href="{{btnurl}}">{{btntext}}</a>{{/hasbtn}}
    </div>
    <div class="instracta-split__media instracta-media--{{imagestyle}}">
        {{#hasimage}}<img src="{{image}}" alt="" loading="lazy">{{/hasimage}}
        {{^hasimage}}<div class="instracta-media__placeholder" aria-hidden="true"><i class="fa-regular fa-image"></i></div>{{/hasimage}}
    </div>
</div>

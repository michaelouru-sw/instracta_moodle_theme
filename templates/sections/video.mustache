{{!
    @template theme_instracta/sections/video

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
{{#hasvideo}}
<div class="instracta-video instracta-ratio--{{ratio}}">
    {{#isfile}}<video controls preload="metadata"{{#hasposter}} poster="{{poster}}"{{/hasposter}}><source src="{{embed}}"></video>{{/isfile}}
    {{#direct}}<iframe src="{{embed}}" title="{{title}}" loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>{{/direct}}
    {{#deferred}}
    <button type="button" class="instracta-video__poster" data-instracta-embed="{{embed}}" data-instracta-title="{{title}}" style="background-image: url('{{poster}}')" aria-label="{{#str}}playvideo, theme_instracta{{/str}}">
        <span class="instracta-video__play"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
    </button>
    {{/deferred}}
</div>
{{/hasvideo}}
{{^hasvideo}}<p class="instracta-empty">{{#str}}b_addvideo, theme_instracta{{/str}}</p>{{/hasvideo}}

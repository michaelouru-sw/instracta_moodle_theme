{{!
    @template theme_instracta/sections/categories

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
{{#hastiles}}
<div class="instracta-grid instracta-grid--{{columns}}">
    {{#tiles}}
    <a class="instracta-tile" href="{{url}}">
        <span class="instracta-icon"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span>
        <span class="instracta-tile__name">{{name}}</span>
        {{#showcount}}<span class="instracta-tile__count">{{#str}}coursecount, theme_instracta, {{count}}{{/str}}</span>{{/showcount}}
        <i class="fa-solid fa-arrow-right instracta-tile__arrow" aria-hidden="true"></i>
    </a>
    {{/tiles}}
</div>
{{/hastiles}}
{{^hastiles}}<p class="instracta-empty">{{#str}}nocategories, theme_instracta{{/str}}</p>{{/hastiles}}

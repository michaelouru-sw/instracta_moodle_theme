{{!
    @template theme_instracta/sections/hero

    Instracta page builder template.

    Example context (json):
    {}
}}
<div class="instracta-hero instracta-hero--{{layout}} instracta-hero--h-{{height}}">
    <div class="instracta-hero__text">
        {{#eyebrow}}<p class="instracta-eyebrow instracta-eyebrow--pill">{{eyebrow}}</p>{{/eyebrow}}
        <h1 class="instracta-hero__title">{{title}}</h1>
        {{#subtitle}}<p class="instracta-hero__lead">{{subtitle}}</p>{{/subtitle}}
        {{#showsearch}}
        <form class="instracta-hero__search" action="{{searchaction}}" method="get" role="search">
            <label class="visually-hidden" for="instracta-hs-{{sectionid}}">{{#str}}searchcourses, theme_instracta{{/str}}</label>
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input id="instracta-hs-{{sectionid}}" type="search" name="search" placeholder="{{#str}}searchcourses, theme_instracta{{/str}}" autocomplete="off">
            <button type="submit" class="btn btn-primary">{{#str}}search, core{{/str}}</button>
        </form>
        {{/showsearch}}
        {{#hasactions}}
        <div class="instracta-hero__actions">
            {{#hasbtn1}}<a class="btn btn-lg instracta-btn-solid" href="{{btn1url}}">{{btn1text}}</a>{{/hasbtn1}}
            {{#hasbtn2}}<a class="btn btn-lg instracta-btn-ghost" href="{{btn2url}}">{{btn2text}}</a>{{/hasbtn2}}
        </div>
        {{/hasactions}}
        {{#hasbullets}}
        <ul class="instracta-hero__bullets">
            {{#bullets}}<li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{{text}}</span></li>{{/bullets}}
        </ul>
        {{/hasbullets}}
    </div>
    {{#layout_split}}
    <div class="instracta-hero__media">
        {{#image}}<img src="{{image}}" alt="" loading="eager">{{/image}}
        {{^image}}
        <div class="instracta-hero__art" aria-hidden="true">
            <div class="instracta-art-card instracta-art-card--a">
                <span class="instracta-art-thumb"></span><span class="instracta-art-line"></span><span class="instracta-art-line instracta-art-line--short"></span>
            </div>
            <div class="instracta-art-card instracta-art-card--b">
                <span class="instracta-art-ring"><i class="fa-solid fa-graduation-cap"></i></span>
                <span class="instracta-art-line"></span><span class="instracta-art-line instracta-art-line--short"></span>
            </div>
            <div class="instracta-art-card instracta-art-card--c">
                <i class="fa-solid fa-award"></i><span class="instracta-art-line instracta-art-line--short"></span>
            </div>
        </div>
        {{/image}}
    </div>
    {{/layout_split}}
</div>

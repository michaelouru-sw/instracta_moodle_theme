{{!
    @template theme_instracta/sections/stats

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
<div class="instracta-stats instracta-stats--{{look}}"{{#animate}} data-instracta-animate="1"{{/animate}}>
    {{#items}}
    <div class="instracta-stat">
        <span class="instracta-icon instracta-icon--sm"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span>
        <div class="instracta-stat__value">{{prefix}}<span{{#animatable}} data-instracta-count="{{count}}"{{/animatable}}>{{display}}</span>{{suffix}}</div>
        <div class="instracta-stat__label">{{label}}</div>
    </div>
    {{/items}}
</div>

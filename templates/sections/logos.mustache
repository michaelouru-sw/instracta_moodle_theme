{{!
    @template theme_instracta/sections/logos

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#title}}<p class="instracta-logos__title">{{title}}</p>{{/title}}
{{#hasitems}}
<div class="instracta-logos{{#grayscale}} instracta-logos--gray{{/grayscale}}">
    {{#items}}
    {{#haslink}}<a class="instracta-logo" href="{{url}}" title="{{name}}">{{/haslink}}{{^haslink}}<span class="instracta-logo" title="{{name}}">{{/haslink}}
        <img src="{{image}}" alt="{{name}}" loading="lazy">
    {{#haslink}}</a>{{/haslink}}{{^haslink}}</span>{{/haslink}}
    {{/items}}
</div>
{{/hasitems}}
{{^hasitems}}{{#preview}}<p class="instracta-empty">{{#str}}b_addlogos, theme_instracta{{/str}}</p>{{/preview}}{{/hasitems}}

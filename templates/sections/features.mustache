{{!
    @template theme_instracta/sections/features

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
<div class="instracta-grid instracta-grid--{{columns}} instracta-cards--{{cardstyle}}">
    {{#items}}
    {{#haslink}}<a class="instracta-feature instracta-feature--link" href="{{url}}">{{/haslink}}{{^haslink}}<div class="instracta-feature">{{/haslink}}
        <span class="instracta-icon"><i class="fa-solid fa-{{icon}}" aria-hidden="true"></i></span>
        <h3 class="instracta-feature__title">{{title}}</h3>
        <p class="instracta-feature__text">{{text}}</p>
    {{#haslink}}</a>{{/haslink}}{{^haslink}}</div>{{/haslink}}
    {{/items}}
</div>

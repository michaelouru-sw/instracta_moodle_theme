{{!
    @template theme_instracta/sections/cta

    Instracta page builder template.

    Example context (json):
    {}
}}
<div class="instracta-cta instracta-cta--{{align}}">
    <h2 class="instracta-cta__title">{{title}}</h2>
    {{#text}}<p class="instracta-cta__text">{{text}}</p>{{/text}}
    <div class="instracta-cta__actions">
        {{#hasbtn1}}<a class="btn btn-lg instracta-btn-solid" href="{{btn1url}}">{{btn1text}}</a>{{/hasbtn1}}
        {{#hasbtn2}}<a class="btn btn-lg instracta-btn-ghost" href="{{btn2url}}">{{btn2text}}</a>{{/hasbtn2}}
    </div>
</div>

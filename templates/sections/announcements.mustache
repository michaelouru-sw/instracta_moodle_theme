{{!
    @template theme_instracta/sections/announcements

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
{{#hasposts}}
<div class="instracta-grid instracta-grid--3">
    {{#posts}}
    <a class="instracta-news" href="{{url}}">
        {{#showdate}}<span class="instracta-news__date">{{date}}</span>{{/showdate}}
        <h3 class="instracta-news__title">{{title}}</h3>
        <p class="instracta-news__excerpt">{{excerpt}}</p>
        <span class="instracta-link">{{#str}}readmore, theme_instracta{{/str}} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
    </a>
    {{/posts}}
</div>
{{#hasforum}}<div class="instracta-more"><a class="btn btn-outline-primary" href="{{forumurl}}">{{#str}}allannouncements, theme_instracta{{/str}}</a></div>{{/hasforum}}
{{/hasposts}}
{{^hasposts}}<p class="instracta-empty">{{#str}}noannouncements, theme_instracta{{/str}}</p>{{/hasposts}}

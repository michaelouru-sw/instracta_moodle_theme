{{!
    @template theme_instracta/sections/gallery

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
{{#hasitems}}
<div class="instracta-gallery instracta-gallery--{{look}} instracta-gallery--{{columns}}">
    {{#items}}
    <figure class="instracta-gallery__item">
        {{#haslink}}<a href="{{url}}">{{/haslink}}<img src="{{image}}" alt="{{caption}}" loading="lazy">{{#haslink}}</a>{{/haslink}}
        {{#caption}}<figcaption>{{caption}}</figcaption>{{/caption}}
    </figure>
    {{/items}}
</div>
{{/hasitems}}
{{^hasitems}}<p class="instracta-empty">{{#str}}b_addimages, theme_instracta{{/str}}</p>{{/hasitems}}

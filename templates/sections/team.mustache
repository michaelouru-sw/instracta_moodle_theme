{{!
    @template theme_instracta/sections/team

    Instracta page builder template.

    Example context (json):
    {}
}}
{{#hashead}}<header class="instracta-head instracta-head--center">{{> theme_instracta/sections/partial_head }}</header>{{/hashead}}
<div class="instracta-grid instracta-grid--{{columns}}">
    {{#items}}
    <div class="instracta-member">
        {{#hasphoto}}<img class="instracta-member__photo" src="{{photo}}" alt="" loading="lazy">{{/hasphoto}}
        {{^hasphoto}}<span class="instracta-member__photo instracta-member__photo--initial" aria-hidden="true">{{initial}}</span>{{/hasphoto}}
        <h3 class="instracta-member__name">{{name}}</h3>
        {{#role}}<p class="instracta-member__role">{{role}}</p>{{/role}}
        {{#bio}}<p class="instracta-member__bio">{{bio}}</p>{{/bio}}
    </div>
    {{/items}}
</div>

{{!
    @template theme_instracta/course_banner

    Header banner of the course home page. The look (hero, split, minimal) is chosen with CSS.

    Example context (json):
    {
        "name": "Introduction to Instructional Design",
        "hascategory": true,
        "category": "Professional development",
        "categoryurl": "https://example.org/course/index.php?categoryid=1",
        "hassummary": true,
        "summary": "Learn how to analyse needs and design learning that sticks.",
        "image": "https://example.org/pluginfile.php/1/course/overviewfiles/c.png",
        "hasteachers": true,
        "teachers": "Daniel Otieno",
        "learners": 120,
        "sections": 6,
        "hasprogress": true,
        "progress": 45,
        "progresslabel": "45% complete",
        "hasaction": true,
        "actionurl": "https://example.org/mod/page/view.php?id=2",
        "actionlabel": "Continue"
    }
}}
<section class="instracta-cbanner" aria-label="{{#str}}cb_aria, theme_instracta{{/str}}">
    <div class="instracta-cbanner__media" style="background-image: url('{{{ image }}}')" role="presentation"></div>
    <div class="instracta-cbanner__body">
        {{#hascategory}}<div class="instracta-cbanner__crumb"><a href="{{{ categoryurl }}}">{{ category }}</a></div>{{/hascategory}}
        <h1 class="instracta-cbanner__title">{{ name }}</h1>
        {{#hassummary}}<p class="instracta-cbanner__summary">{{ summary }}</p>{{/hassummary}}
        <ul class="instracta-cbanner__meta">
            {{#hasteachers}}<li><i class="fa-solid fa-chalkboard-user" aria-hidden="true"></i>{{ teachers }}</li>{{/hasteachers}}
            <li><i class="fa-solid fa-user-group" aria-hidden="true"></i>{{ learners }}</li>
            {{#sections}}<li><i class="fa-solid fa-layer-group" aria-hidden="true"></i>{{ sections }}</li>{{/sections}}
        </ul>
        {{#hasprogress}}
        <div class="instracta-cbanner__progress">
            <div class="progress" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ progresslabel }}"><div class="progress-bar" style="width: {{ progress }}%"></div></div>
            <span>{{ progresslabel }}</span>
        </div>
        {{/hasprogress}}
        {{#hasaction}}<div class="instracta-cbanner__actions"><a class="btn btn-primary" href="{{{ actionurl }}}">{{ actionlabel }}</a></div>{{/hasaction}}
    </div>
</section>

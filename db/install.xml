<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="theme/instracta/db" VERSION="20261012" COMMENT="XMLDB file for the Instracta theme"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="theme_instracta_page" COMMENT="Page builder layouts: one draft, one published and archived revisions per page.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pagekey" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="home" SEQUENCE="false" COMMENT="Which page the layout belongs to"/>
        <FIELD NAME="status" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft, published or archived"/>
        <FIELD NAME="layout" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Sanitised JSON layout"/>
        <FIELD NAME="note" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Revision note"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="pagekey-status" UNIQUE="false" FIELDS="pagekey, status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
